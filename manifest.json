{
  "manifest_version": 3,
  "name": "Pinterest Board Downloader",
  "version": "1.0.0",
  "description": "Baixa todas as imagens de uma pasta do Pinterest e salva em .zip",
  "permissions": ["activeTab","scripting","downloads","storage"],
  "host_permissions": ["https://*.pinterest.com/*","https://*.pinimg.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "content_scripts": [{"matches":["https://*.pinterest.com/*"],"js":["content.js"]}],
  "background": {"service_worker":"background.js"}
}
